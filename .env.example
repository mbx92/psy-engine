# Database (required)
DATABASE_URL=postgres://user:password@localhost:5432/psy_engine

# Auth (required in production — use a long random string)
JWT_SECRET=replace-with-at-least-32-random-characters

# LAN QA: false. Public Cloudflare Tunnel hostname: true + set APP_ORIGIN.
AUTH_COOKIE_SECURE=false
# Enable only behind a trusted reverse proxy that controls X-Forwarded-For.
TRUST_PROXY=false
# Public HTTPS origin (Cloudflare Tunnel). Required when cloudflared runs on
# another machine and the service URL is a LAN IP:port.
# APP_ORIGIN=https://assessment.example.com

# Server (Docker / Coolify defaults)
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# Entrypoint (defaults are safe/idempotent)
# RUN_MIGRATIONS=true
# SEED_ON_BOOT=true
# SEED_FORCE_TESTS=false

# Optional: show Fill Dev / test helpers (never enable in real production)
# NUXT_PUBLIC_DEV_TEST_TOOLS=true

# CORS — needed when Cloudflare Tunnel runs on another machine and the
# browser origin is the public hostname while the app is on a LAN IP:port.
# Default * echoes the request Origin. Restrict in production, e.g.:
# CORS_ORIGINS=https://psy.example.com,https://*.trycloudflare.com
# CORS_ORIGINS=*
