# Database (required)
DATABASE_URL=postgres://user:password@localhost:5432/psy_engine

# Auth (required in production — use a long random string)
JWT_SECRET=replace-with-at-least-32-random-characters

# LAN QA: false. Public Cloudflare Tunnel hostname: true + set APP_ORIGIN.
AUTH_COOKIE_SECURE=false
# Enable only behind a trusted reverse proxy that controls X-Forwarded-For.
TRUST_PROXY=false
# APP_ORIGIN=https://assessment.example.com

# Server (Docker / Coolify defaults)
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# Entrypoint (defaults are safe/idempotent)
# RUN_MIGRATIONS=true
# SEED_ON_BOOT=true
# SEED_FORCE_TESTS=false

# Optional: show Fill Dev / test helpers (never enable in real production)
# NUXT_PUBLIC_DEV_TEST_TOOLS=true
