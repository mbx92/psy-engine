# Database (required)
DATABASE_URL=postgres://user:password@localhost:5432/psy_engine

# Auth (required in production — use a long random string)
JWT_SECRET=change-me-to-a-long-random-secret

# Server (Docker / Coolify defaults)
HOST=0.0.0.0
PORT=3000
NODE_ENV=production

# Entrypoint flags
# RUN_MIGRATIONS=true
# SEED_RBAC=false
